# Copy to .env (gitignored) or export in the shell.
# AP SSH creds now live in the app's inventory (controllers/targets) — set them in the UI.
# CT_AP_PASSWORD is only a FALLBACK for ad-hoc captures / targets with no stored password.
CT_AP_PASSWORD=
CT_AP_USERNAME=admin
# CT_DATABASE_URL=postgresql+asyncpg://capture:capture@127.0.0.1:5432/capture  # Docker sets this
# Optional overrides:
# CT_HOST_IP=10.0.71.115      # local IP advertised to rpcapd (auto-detected if unset)
# CT_HEARTBEAT_TIMEOUT_S=30
