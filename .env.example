# Copy to .env (gitignored) and fill in. docker compose reads this file and ERRORS
# if a required value is unset — nothing is defaulted in docker-compose.yml.
#
#   cp .env.example .env  &&  edit .env  &&  docker compose up -d --build

# --- Postgres (all REQUIRED) ---
CT_DB_USER=capture
CT_DB_PASSWORD=change-me
CT_DB_NAME=capture
CT_DB_PORT=5432

# --- capture storage (REQUIRED) ---
CT_CAPTURE_DIR=/data/captures      # path INSIDE the api container
CT_CAPTURE_DATA=./data             # host path bind-mounted to /data

# --- optional AP SSH fallback (creds normally come from the inventory) ---
# Uncomment only if you want a global fallback for targets with no stored password.
# CT_AP_USERNAME=admin
# CT_AP_PASSWORD=
